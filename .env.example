# Chemin vers le fichier bot.db de golden-chicken-stats (source de verite).
# En production, doit pointer vers le meme fichier/volume que la variable
# DB_PATH du bot golden-chicken-stats pour lire des donnees a jour.
DB_PATH=bot.db

# Port d'ecoute du serveur web (Nixpacks fournit automatiquement $PORT en prod)
PORT=8000
